// Cloudflare Workers deploy for pdfedit.beverly.directory (static assets only).
// The custom domain and Cloudflare Access are configured in the dashboard.
{
  "name": "pdfedit",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Keep the site reachable only through the Access-protected custom domain.
  "workers_dev": false,
  "preview_urls": false
}
